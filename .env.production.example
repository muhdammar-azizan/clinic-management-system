# Settings for a hosted copy of the app (Hostinger or any PHP host with MySQL).
# Copy this file to .env on the server and fill in the values. Never commit real values.

APP_NAME="Clinic Management System"
APP_ENV=production
APP_DEBUG=false
# Make one on your computer with: php artisan key:generate --show
APP_KEY=
APP_URL=https://your-domain.example

# Use https in every generated link and mark the session cookie as secure.
APP_FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
# Only needed behind a proxy or load balancer. Narrow it to its addresses if you know them.
TRUSTED_PROXIES=*

# Write errors to storage/logs instead of the screen.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Create the database and user in hPanel under Databases, then copy the values here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Medical record files are saved in storage/app/private. That folder is outside the public folder
# and survives a deploy, so do not delete it when you upload a new version.
FILESYSTEM_DISK=local

# Used only by the Docker image. Ignore them on shared hosting.
RUN_MIGRATIONS=1
RUN_DEMO_SEED=0
