# Settings for a hosted copy of the app. Set these as environment variables on the platform.
# Never commit real values.

APP_NAME="Clinic Management System"
APP_ENV=production
APP_DEBUG=false
# Make one with: php artisan key:generate --show
APP_KEY=
APP_URL=https://your-app.example.com

# Use https in every generated link and mark the session cookie as secure.
APP_FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
# The platform's proxy sits in front of the app. Narrow this to its addresses if you know them.
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Most platforms give one connection address. Or set DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD.
DB_CONNECTION=pgsql
DB_URL=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Medical record files are saved on this disk. Mount a persistent volume at storage/app/private,
# or the files disappear on every deploy.
FILESYSTEM_DISK=local

# Container start-up switches. Run migrations on every start, and add the demo accounts only on an empty database.
RUN_MIGRATIONS=1
RUN_DEMO_SEED=0
